@model FilmesMVC.Models.GeneroViewModel

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div class="d-flex align-items-center">
            <a href="/Genero/Index" class="text-muted text-decoration-none me-3" title="Voltar">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
                </svg>
            </a>
            <h1 class="mb-0">Editar Gênero</h1>
        </div>
    </div>
    <div class="p-4 p-md-5 rounded-4" style="background-color: var(--bg-card);">
        <form asp-action="Editar" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <div class="col-mb-4">
                <label class="form-label text-muted fw-semibold small text-uppercase">Nome do gênero: <span class="text-danger">*</span></label>
                <input asp-for="Nome" class="form-control form-control-lg" required placeholder="" />
            </div>

            <div class="d-flex flex-column-reverse flex-sm-row justify-content-sm-end align-items-stretch align-items-sm-center mt-3 pt-4 gap-3" style="border-color: var(--border-subtle) !important;">
                <a href="/Genero/Index" class="btn btn-link text-muted text-decoration-none text-center">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">
                    Salvar alterações
                </button>
            </div>
        </form>
    </div>
</div>