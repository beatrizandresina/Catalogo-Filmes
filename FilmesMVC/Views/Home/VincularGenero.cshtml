@model List<FilmesMVC.Models.GeneroViewModel>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div class="d-flex align-items-center">
            <a href="/Home/Detalhes/@ViewBag.FilmeId" class="text-muted text-decoration-none me-3" title="Voltar">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
                </svg>
            </a>
            <h1 class="mb-0">Vincular Género</h1>
        </div>
    </div>

    <div class="p-4 p-md-5 rounded-4 mx-auto" style="background-color: var(--bg-card); max-width: 600px;">
        <form asp-action="VincularGeneroConfirmado" method="post">
            <input type="hidden" name="filmeId" value="@ViewBag.FilmeId" />

            <div class="mb-5">
                <label class="form-label text-muted fw-semibold small text-uppercase d-flex align-items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-tags-fill me-2" viewBox="0 0 16 16">
                        <path d="M2 2a1 1 0 0 1 1-1h4.586a1 1 0 0 1 .707.293l7 7a1 1 0 0 1 0 1.414l-4.586 4.586a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 2 6.586V2zm3.5 4a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z" />
                        <path d="M1.293 7.793A1 1 0 0 1 1 7.086V2a1 1 0 0 0-1 1v4.586a1 1 0 0 0 .293.707l7 7a1 1 0 0 0 1.414 0l.043-.043-7.457-7.457z" />
                    </svg>
                    Selecione o Género <span class="text-danger ms-1">*</span>
                </label>

                <select name="generoId" class="form-select form-select-lg text-white shadow-none" style="background-color: var(--bg-dark); border-color: var(--border-subtle);" required>
                    <option value="" disabled selected>-- Escolha um Género --</option>
                    @foreach (var genero in Model)
                    {
                        <option value="@genero.Id">@genero.Nome</option>
                    }
                </select>
            </div>

            <div class="d-flex flex-column-reverse flex-sm-row justify-content-sm-end align-items-stretch align-items-sm-center mt-5 pt-4 border-top gap-3" style="border-color: var(--border-subtle) !important;">
                <a href="/Home/Detalhes/@ViewBag.FilmeId" class="btn btn-link text-muted text-decoration-none text-center">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">
                    Adicionar ao Filme
                </button>
            </div>
        </form>
    </div>
</div>