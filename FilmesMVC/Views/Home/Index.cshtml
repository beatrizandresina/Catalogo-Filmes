@using FilmesMVC.Controllers
@model List<FilmeViewModel>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="mb-0">Catálogo</h1>
        <a href="/Home/Adicionar" class="btn btn-success rounded-pill px-4">
            <i class="bi bi-plus-lg me-1"></i> Adicionar Filme
        </a>
    </div>

    <form method="get" action="/Home/Index" class="mb-5 search-bar-container">
        <div class="input-group rounded-pill overflow-hidden">
            <span class="input-group-text bg-transparent border-0 text-muted ps-4" id="search-addon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                </svg>
            </span>
            <input type="text" name="pesquisaTitulo" class="form-control form-control-lg border-0 bg-transparent" placeholder="Pesquisar filme pelo nome, diretor..." aria-describedby="search-addon" />
            <button type="submit" class="btn btn-primary px-4 rounded-pill m-1">Buscar</button>
            <a href="/Home/Index" class="btn btn-outline-secondary px-4 m-1 me-2 rounded-pill border-0 text-decoration-none d-flex align-items-center">Limpar</a>
        </div>
    </form>

    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 row-cols-xl-6 g-4">
        @foreach (var filme in Model)
        {
            <div class="col">
                <a href="/Home/Detalhes/@filme.Id" class="movie-card text-decoration-none h-100 d-flex flex-column rounded-4 overflow-hidden" style="background-color: var(--bg-card); border: 1px solid var(--border-subtle);">

                    @if (!string.IsNullOrEmpty(filme.CapaUrl))
                    {
                        <img src="@filme.CapaUrl" alt="@filme.Titulo" class="w-100" style="aspect-ratio: 2/3; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="movie-poster-placeholder w-100 d-flex flex-column align-items-center justify-content-center text-muted" style="aspect-ratio: 2/3; background-color: var(--bg-dark);">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#4A4A55" class="bi bi-film mb-2" viewBox="0 0 16 16">
                                <path d="M0 1a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1zm4 0v6h8V1zm8 8H4v6h8zM1 1v2h2V1zm2 3H1v2h2zM1 7v2h2V7zm2 3H1v2h2zm-2 3v2h2v-2zM15 1h-2v2h2zm-2 3v2h2V4zm2 3h-2v2h2zm-2 3v2h2v-2zm2 3h-2v2h2z" />
                            </svg>
                            <span style="font-size: 0.8rem;">Sem Capa</span>
                        </div>
                    }

                    <div class="card-body p-3 mt-auto">
                        <h5 class="card-title fw-bold fs-6 mb-1 text-white text-truncate" title="@filme.Titulo">@filme.Titulo</h5>

                        @{
                            var diretor = filme.Profissionais?.FirstOrDefault(p => p.Funcao == "Diretor")?.Profissional?.Nome ?? "Sem diretor";
                        }
                        <h6 class="card-subtitle text-muted text-truncate" style="font-size: 0.8rem;" title="@diretor">@diretor</h6>
                    </div>
                </a>
            </div>
        }
    </div>
</div>