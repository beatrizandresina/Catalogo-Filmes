@model FilmesMVC.Models.FilmeViewModel

<div class="card p-5 mt-5 shadow-lg text-center rounded-4" style="background-color: var(--bg-card); border: 1px dashed #F94144 !important; max-width: 600px; margin: auto;">

    <div class="mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="#F94144" class="bi bi-exclamation-triangle" viewBox="0 0 16 16">
            <path d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.146.146 0 0 1 .054.057l6.857 11.667c.036.06.035.124.002.183a.163.163 0 0 1-.054.06.116.116 0 0 1-.066.017H1.146a.115.115 0 0 1-.066-.017.163.163 0 0 1-.054-.06.176.176 0 0 1 .002-.183L7.884 2.073a.147.147 0 0 1 .054-.057zm1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566z" />
            <path d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995z" />
        </svg>
    </div>

    <h2 style="color: #F94144;" class="fw-bold mb-3">Cuidado!</h2>
    <h5 class="mb-4" style="color: var(--text-primary); line-height: 1.5;">Tem a certeza que deseja apagar o filme <br><strong>"@Model.Titulo"</strong>?</h5>
    <p style="color: var(--text-muted);" class="mb-5">Esta ação é irreversível e o filme será removido permanentemente da base de dados.</p>

    <form asp-action="Excluir" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 w-100 mt-4">
            <a href="/Home/Detalhes/@Model.Id" class="btn btn-outline-secondary rounded-pill px-4 py-2 w-100">Cancelar</a>
            <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 shadow-sm w-100">Sim, Apagar Filme</button>
        </div>
    </form>
</div>