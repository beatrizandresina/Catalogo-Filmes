@model List<FilmesMVC.Models.ProfissionalViewModel>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="mb-0">Vincular Profissional</h1>
    </div>

    <div class="p-4 p-md-5 rounded-4 mx-auto" style="background-color: var(--bg-card); max-width: 600px;">
        <form asp-action="VincularProfissionalConfirmado" method="post">
            <input type="hidden" name="filmeId" value="@ViewBag.FilmeId" />

            <div class="mb-4">
                <label class="form-label text-muted fw-semibold small text-uppercase">Profissional <span class="text-danger">*</span></label>
                <select name="profissionalId" class="form-select form-select-lg text-white shadow-none" style="background-color: var(--bg-dark); border-color: var(--border-subtle);" required>
                    <option value="" disabled selected>-- Escolha a Pessoa --</option>
                    @if (Model != null)
                    {
                        foreach (var p in Model)
                        {
                            <option value="@p.Id">@p.Nome</option>
                        }
                    }
                </select>
            </div>

            <div class="mb-5">
                <label class="form-label text-muted fw-semibold small text-uppercase">Qual foi a função? <span class="text-danger">*</span></label>
                <input type="text" name="funcao" class="form-control form-control-lg text-white" style="background-color: var(--bg-dark); border-color: var(--border-subtle);" placeholder="Ex: Diretor, Ator, Roteirista..." required />
            </div>

            <div class="d-flex justify-content-end pt-4 border-top" style="border-color: var(--border-subtle) !important;">
                <a href="/Home/Detalhes/@ViewBag.FilmeId" class="btn btn-link text-muted text-decoration-none me-4">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5">Vincular</button>
            </div>
        </form>
    </div>
</div>