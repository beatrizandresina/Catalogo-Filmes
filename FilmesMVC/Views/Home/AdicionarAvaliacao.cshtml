@model FilmesMVC.Models.AvaliacaoViewModel

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div class="d-flex align-items-center">
            <a href="/Home/Detalhes/@Model.FilmeId" class="text-muted text-decoration-none me-3" title="Voltar">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
                </svg>
            </a>
            <h1 class="mb-0">Avaliar Filme</h1>
        </div>
    </div>

    <div class="p-4 p-md-5 rounded-4 mx-auto" style="background-color: var(--bg-card); max-width: 800px;">
        <form asp-action="AdicionarAvaliacao" method="post">
            <input type="hidden" asp-for="FilmeId" />

            <div class="mb-4">
                <label class="form-label text-muted fw-semibold small text-uppercase d-flex align-items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#FFD700" class="bi bi-star-fill me-2" viewBox="0 0 16 16">
                        <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z" />
                    </svg>
                    A sua Nota (1 a 5) <span class="text-danger ms-1">*</span>
                </label>
                <input asp-for="Nota" type="number" min="1" max="5" class="form-control form-control-lg" style="max-width: 150px;" required placeholder="Ex: 5" />
            </div>

            <div class="mb-5">
                <label class="form-label text-muted fw-semibold small text-uppercase">Comentário <span class="text-danger">*</span></label>
                <textarea asp-for="Comentario" class="form-control form-control-lg" rows="5" placeholder="O que achou do filme? Escreva a sua opinião..." required></textarea>
            </div>

            <div class="d-flex flex-column-reverse flex-sm-row justify-content-sm-end align-items-stretch align-items-sm-center mt-5 pt-4 border-top gap-3" style="border-color: var(--border-subtle) !important;">
                <a href="/Home/Detalhes/@Model.FilmeId" " class="btn btn-link text-muted text-decoration-none text-center">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">
                    Enviar Avaliação
                </button>
            </div>
        </form>
    </div>
</div>