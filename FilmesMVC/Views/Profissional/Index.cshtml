@model List<ProfissionalViewModel>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="mb-0 fw-bold">Profissionais</h1>
        <a href="/Profissional/Adicionar" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-plus-lg me-2 pb-1" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z" />
            </svg>
            Adicionar Profissional
        </a>
    </div>

    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
        @foreach (var profissional in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 rounded-4 shadow-sm overflow-hidden" style="background-color: var(--bg-card);">

                    @if (!string.IsNullOrEmpty(profissional.FotoUrl))
                    {
                        <img src="@profissional.FotoUrl" alt="@profissional.Nome" class="card-img-top w-100" style="aspect-ratio: 2/3; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="card-img-top d-flex align-items-center justify-content-center w-100" style="aspect-ratio: 2/3; background-color: #2b2b2b;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="#6c757d" class="bi bi-person-fill" viewBox="0 0 16 16">
                                <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H3Zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
                            </svg>
                        </div>
                    }

                    <div class="card-body d-flex flex-column p-3 text-center">
                        <h5 class="fw-bold fs-6 mb-3 text-white text-truncate" title="@profissional.Nome">@profissional.Nome</h5>

                        <div class="mt-auto d-flex justify-content-center gap-2">
                            <a href="/Profissional/Editar/@profissional.Id" class="btn btn-sm rounded-pill px-3" style="background-color: #333; color: #fff; border: 1px solid #444;">
                                Editar
                            </a>
                            <a href="/Profissional/Excluir/@profissional.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                Excluir
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>